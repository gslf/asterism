// Model size "plus": a graphics card with 16 GB.
// asterism setup --tier plus writes this file as ~/asterism/config.xcdn.
// Settings not listed here keep their default.
//
// Qwen3.5 9B answers, Qwen3.5 4B plans and checks, Qwen3.5 0.8B sorts the
// requests, EmbeddingGemma indexes the memory; all on the graphics card.

#asngn_config {
  models: {
    max_resident: 4,
    pool: [
      { id: "nano", path: "models/qwen3.5-0.8b-q8_0.gguf", ctx: 8192,
        threads: 4, gpu_layers: -1 },
      { id: "light", path: "models/qwen3.5-4b-q4_k_m.gguf", ctx: 32768,
        threads: 6, gpu_layers: -1 },
      { id: "std", path: "models/qwen3.5-9b-q6_k.gguf", ctx: 32768,
        threads: 8, gpu_layers: -1 },
      { id: "embed", path: "models/embeddinggemma-300m-q8_0.gguf", ctx: 2048,
        threads: 4, gpu_layers: -1, embedding: true, dim: 768,
        query_prefix: "task: search result | query: ",
        document_prefix: "title: none | text: " },
    ],
    roles: {
      router: "nano",
      planner: "light",
      generator: "std",
      compressor: "light",
      adapter: "light",
      judge: "light",
      embedder: "embed",
    },
  },

  // What the tools may do: astools.xcdn, written by asterism setup.
  integration: { astools: { config: "astools.xcdn" } },
}
