if(POLICY CMP0057)
  cmake_policy(SET CMP0057 NEW)
endif()

if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "model manifest is missing")
endif()
get_filename_component(scripts_dir "${MANIFEST}" DIRECTORY)
get_filename_component(source_dir "${scripts_dir}" DIRECTORY)

set(known_tiers legacy base standard plus)
foreach(tier IN LISTS known_tiers)
  set(tier_${tier} "")
endforeach()

file(STRINGS "${MANIFEST}" lines)
set(names "")
foreach(line IN LISTS lines)
  if(line MATCHES "^[ \t]*#" OR line STREQUAL "")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${line}")
  list(LENGTH fields field_count)
  if(NOT field_count EQUAL 6)
    message(FATAL_ERROR "manifest row does not have six fields: ${line}")
  endif()
  list(GET fields 0 tiers)
  list(GET fields 1 name)
  list(GET fields 2 size)
  list(GET fields 3 sha)
  list(GET fields 4 url)
  list(GET fields 5 post)
  if(NOT name MATCHES "^[a-z0-9][a-z0-9._-]*[.]gguf$")
    message(FATAL_ERROR "invalid local model name: ${name}")
  endif()
  if(name IN_LIST names)
    message(FATAL_ERROR "duplicate model name: ${name}")
  endif()
  list(APPEND names "${name}")
  if(NOT tiers MATCHES "^[a-z]+(,[a-z]+)*$")
    message(FATAL_ERROR "invalid tier list for ${name}: ${tiers}")
  endif()
  string(REPLACE "," ";" row_tiers "${tiers}")
  set(seen "")
  foreach(tier IN LISTS row_tiers)
    if(NOT tier IN_LIST known_tiers)
      message(FATAL_ERROR "unknown tier for ${name}: ${tier}")
    endif()
    if(tier IN_LIST seen)
      message(FATAL_ERROR "tier listed twice for ${name}: ${tier}")
    endif()
    list(APPEND seen "${tier}")
    list(APPEND tier_${tier} "${name}")
  endforeach()
  if(NOT size MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "invalid size for ${name}: ${size}")
  endif()
  string(LENGTH "${sha}" sha_len)
  if(NOT sha_len EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "invalid SHA-256 for ${name}: ${sha}")
  endif()
  if(NOT url MATCHES "^https://huggingface[.]co/[^/]+/[^/]+/resolve/[0-9a-f]+/[^/]+[.]gguf$")
    message(FATAL_ERROR "URL is not a pinned Hugging Face revision: ${url}")
  endif()
  string(REGEX REPLACE "^.*/resolve/([0-9a-f]+)/.*$" "\\1" revision "${url}")
  string(LENGTH "${revision}" revision_len)
  if(NOT revision_len EQUAL 40)
    message(FATAL_ERROR "revision is not an immutable 40-char commit: ${url}")
  endif()
  if(NOT post STREQUAL "-" AND NOT post MATCHES "^[a-z0-9_.]+=[0-9]+$")
    message(FATAL_ERROR "invalid postprocess for ${name}: ${post}")
  endif()
endforeach()

list(LENGTH tier_legacy legacy_count)
if(NOT legacy_count EQUAL 4)
  message(FATAL_ERROR "expected four pinned legacy models, found ${legacy_count}")
endif()

# Both installers must default to the same tier, and that tier must carry
# every model path the engine's built-in configuration loads.
file(STRINGS "${scripts_dir}/fetch-models.sh" sh_default REGEX "^TIER=")
file(STRINGS "${scripts_dir}/fetch-models.ps1" ps_default
     REGEX "\\$Tier = \"[a-z]+\"")
string(REGEX REPLACE "^TIER=([a-z]+)$" "\\1" sh_default "${sh_default}")
string(REGEX REPLACE "^.*\\$Tier = \"([a-z]+)\".*$" "\\1" ps_default "${ps_default}")
if(NOT sh_default IN_LIST known_tiers OR NOT ps_default STREQUAL sh_default)
  message(FATAL_ERROR
    "installers disagree on the default tier: sh='${sh_default}' ps1='${ps_default}'")
endif()
file(STRINGS "${source_dir}/asngn/src/config.c" default_lines
     REGEX "\"models/[^\"]+[.]gguf\"")
string(REGEX MATCHALL "models/[^\"]+[.]gguf" default_paths "${default_lines}")
list(LENGTH default_paths default_count)
if(default_count EQUAL 0)
  message(FATAL_ERROR "no built-in model paths found in asngn/src/config.c")
endif()
foreach(path IN LISTS default_paths)
  string(REGEX REPLACE "^models/" "" file "${path}")
  if(NOT file IN_LIST tier_${sh_default})
    message(FATAL_ERROR
      "built-in default ${path} is not in the default tier '${sh_default}'")
  endif()
endforeach()

# Every non-legacy tier ships examples/<tier>.xcdn whose pool loads exactly
# the files of that tier.
foreach(tier IN LISTS known_tiers)
  list(LENGTH tier_${tier} tier_count)
  if(tier_count LESS 2)
    message(FATAL_ERROR "tier ${tier} has ${tier_count} models")
  endif()
  if(tier STREQUAL "legacy")
    continue()
  endif()
  set(example "${source_dir}/examples/${tier}.xcdn")
  if(NOT EXISTS "${example}")
    message(FATAL_ERROR "tier ${tier} has no engine config: ${example}")
  endif()
  file(STRINGS "${example}" path_lines REGEX "path: *\"models/")
  string(REGEX MATCHALL "path: *\"models/[^\"]*\"" path_fields "${path_lines}")
  set(used "")
  foreach(field IN LISTS path_fields)
    string(REGEX REPLACE "^path: *\"(.*)\"$" "\\1" path "${field}")
    string(REGEX REPLACE "^models/" "" file "${path}")
    if(NOT file IN_LIST tier_${tier})
      message(FATAL_ERROR "${example}: ${path} is not in tier ${tier}")
    endif()
    list(APPEND used "${file}")
  endforeach()
  foreach(file IN LISTS tier_${tier})
    if(NOT file IN_LIST used)
      message(FATAL_ERROR "${example}: tier ${tier} model ${file} is unused")
    endif()
  endforeach()
endforeach()
